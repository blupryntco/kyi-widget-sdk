{
  "name": "@bluprynt/kyi-widget-sdk",
  "version": "0.0.0",
  "description": "Bluprynt KYI Widget SDK - Embed Know Your Issuer verification into your application",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "concurrently -k -n build,serve -c blue,green \"tsdown --watch --out-dir docs/dist\" \"npx serve docs -l 3000\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "prerelease": "pnpm run build",
    "release": "changeset publish"
  },
  "packageManager": "pnpm@9.15.1",
  "keywords": [
    "bluprynt",
    "kyi",
    "know-your-issuer",
    "widget",
    "iframe",
    "sdk",
    "verification",
    "web3",
    "wallet"
  ],
  "author": "Bluprynt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluprynt/kyi-widget-sdk.git"
  },
  "homepage": "https://github.com/bluprynt/kyi-widget-sdk#readme",
  "bugs": {
    "url": "https://github.com/bluprynt/kyi-widget-sdk/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "concurrently": "^9.1.2",
    "tsdown": "^0.9.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "engines": {
    "node": ">=18"
  }
}
